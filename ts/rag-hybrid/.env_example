# --- Required ---
# OpenAI: dense embeddings (text-embedding-3-small) + chat model
OPENAI_API_KEY=

# --- Chroma connection (pick ONE provider) ---
#
# CLOUD: set all three and the app uses Chroma Cloud with NATIVE sparse
# vector indexes + server-side Search()/Rrf fusion.
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=
#
# LOCAL (default when cloud vars are absent): Docker via docker compose up -d
CHROMA_URL=http://localhost:8100

# --- Optional ---
PORT=6200
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
