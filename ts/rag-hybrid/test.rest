# ============================================================
# rag-hybrid - manual API tests
#
# Prerequisites:
#   1. docker compose up -d       -> Chroma on :8100
#   2. pnpm dev:rag-hybrid        -> Express API on :6200
#   3. .env with OPENAI_API_KEY   -> embeddings + chat model
#
# Run each request with "Send Request" (VS Code REST Client).
# On first run execute in order: 1 -> 2 -> 3..6.
#
# The reranker model (~90MB) downloads on first /query with
# "rerank": true or /chat call, then is cached in .cache/.
# ============================================================

# ------------------------------------------------------------
# 1. Health check
# Verifies Chroma connection, document count, BM25 index and
# whether the cross-encoder reranker has been loaded yet.
# Expected 200: { "status": "healthy", "documents": 7, ... }
# ------------------------------------------------------------
GET http://localhost:6200/health

###

# ------------------------------------------------------------
# 2. Ingest movies into the "movies" collection
# Recreates the collection (delete + create) and upserts all
# documents from data/movies.json with deterministic ids
# ("title-year"), so re-running is idempotent.
# Dense embeddings are generated by OpenAI; the sparse BM25
# index is built in-memory from the same file.
# Expected 201: { "ingested": 7 }
# ------------------------------------------------------------
POST http://localhost:6200/ingest
Content-Type: application/json

###

# ------------------------------------------------------------
# 3. Dense-only search (semantic similarity)
# mode: "dense" | "sparse" | "hybrid"
# Paraphrase query - no plot text shares these exact words.
# Expected: inception-2010 top-1 via vector distance.
# ------------------------------------------------------------
POST http://localhost:6200/query
Content-Type: application/json

{
  "query": "a movie about dreams within dreams",
  "mode": "dense",
  "k": 3
}

###

# ------------------------------------------------------------
# 4. Sparse-only search (BM25 keyword scoring)
# Exact names/tokens - the dense channel's blind spot.
# Expected: unstoppable-2010 top-1 with a large BM25 score.
# ------------------------------------------------------------
POST http://localhost:6200/query
Content-Type: application/json

{
  "query": "Unstoppable Denzel Washington train",
  "mode": "sparse",
  "k": 3
}

###

# ------------------------------------------------------------
# 5. Hybrid search (RRF fusion of both channels)
# Response includes per-channel breakdown under "channels"
# and each fused result lists which channels contributed.
# Expected: results tagged ["dense","sparse"].
# ------------------------------------------------------------
POST http://localhost:6200/query
Content-Type: application/json

{
  "query": "Denzel Washington action thriller",
  "mode": "hybrid",
  "k": 4
}

###

# ------------------------------------------------------------
# 6. Hybrid + cross-encoder reranking
# "rerank": true scores every candidate with a local
# ms-marco MiniLM cross-encoder (query+doc jointly encoded),
# returns sigmoid-normalized relevance in rerankScore plus
# orderBefore/orderAfter id lists for comparison.
# Expected: relevant docs near 1.0, filler near 0.0.
# ------------------------------------------------------------
POST http://localhost:6200/query
Content-Type: application/json

{
  "query": "runaway freight train barreling toward a city",
  "mode": "hybrid",
  "k": 5,
  "rerank": true,
  "topN": 3
}

###

# ------------------------------------------------------------
# 7. Chat with hybrid RAG (retrieve -> fuse -> rerank -> LLM)
# Body: { query, k? } - always uses hybrid retrieval and keeps
# the top-k reranked chunks as context. Returns JSON:
# { answer, sources, tookMs } where sources carry rerankScore.
# Expected: answer about Unstoppable citing [1].
# ------------------------------------------------------------
POST http://localhost:6200/chat
Content-Type: application/json

{
  "query": "Which movie has Denzel Washington trying to stop a train?",
  "k": 4
}
