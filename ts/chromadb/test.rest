# ------------------------------------------------------------
# 4. Semantic query (raw vector search)
# Body: { query } - always returns the TOP-1 match (nResults is
# hardcoded to 1) as the raw ChromaDB result shape:
# { ids, documents, metadatas, distances } per query batch.
# Expected: A Clockwork Orange (the only 1971 movie).
# ------------------------------------------------------------
POST http://localhost:3000/collections/test_collection/query
Content-Type: application/json

{
  "query": "1971 movies?"
}

###

# ------------------------------------------------------------
# 5. Chat with RAG
# Body: { query, sessionId?, collectionName?, nResults? }
# Defaults: sessionId="default", collectionName="test_collection",
# nResults=5. Retrieves top-n documents, answers with GPT-4o from
# that context only, and keeps history under the given sessionId
# IN MEMORY (history resets when the server restarts).
# Returns JSON: { "answer": "..." }
# Expected: answer about animated movies from 2010 (Toy Story 3,
# Tangled, Despicable Me).
# ------------------------------------------------------------
POST http://localhost:3000/chat
Content-Type: application/json

{
  "query": "Tell me about animated movies from 2010",
  "sessionId": "test-session",
  "collectionName": "test_collection",
  "nResults": 3
}

###

# ------------------------------------------------------------
# 6. Follow-up question (tests session memory)
# Same sessionId as request 5: "them" must resolve via the stored
# chat history to the animated movies from the previous turn.
# Expected: actors from Toy Story 3 / Tangled / Despicable Me.
# ------------------------------------------------------------
POST http://localhost:3000/chat
Content-Type: application/json

{
  "query": "What actors star in them?",
  "sessionId": "test-session",
  "collectionName": "test_collection",
  "nResults": 3
}
