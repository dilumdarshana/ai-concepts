# ============================================================
# chromadb - manual API tests
#
# Prerequisites:
#   1. docker compose up -d       -> Chroma server on :8000
#   2. pnpm dev:chromadb          -> Express API on :3000
#   3. .env with OPENAI_API_KEY   -> embeddings + chat model
#
# Run each request with "Send Request" (VS Code REST Client).
# On first run execute in order: 1 -> 2 -> 3 -> 4/5.
# ============================================================

# ------------------------------------------------------------
# 1. Health check
# Verifies Express is up and Chroma answers its heartbeat.
# Expected 200: { "status": "healthy", "chroma": "connected" }
# ------------------------------------------------------------
GET http://localhost:3000/health

###

# ------------------------------------------------------------
# 2. Create collection "test_collection"
# Body: { name, metadata? }
# Expected 201: { "message": "Collection test_collection created" }
# Re-running fails with 400 because the collection already exists.
# ------------------------------------------------------------
POST http://localhost:3000/collections
Content-Type: application/json

{
  "name": "test_collection",
  "metadata": {
    "description": "This is a test collection"
  }
}

###

# ------------------------------------------------------------
# 3. Insert documents into "test_collection"
# Body: { documents: [{ document, metadata }] }
# Each document gets a RANDOM id server-side, so re-running this
# request inserts duplicates instead of updating existing rows.
# Expected 201: { "message": "Documents inserted into collection ..." }
