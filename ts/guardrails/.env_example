OPENAI_API_KEY=xxxx

# Model used to generate answers (default: gpt-4o)
LLM_MODEL=gpt-4o

# Model used as the LLM-as-judge (default: same as LLM_MODEL).
# Set to a different, ideally stronger model to avoid self-preference bias.
JUDGE_MODEL=gpt-4o

# Langfuse observability (optional — tracing is off when unset)
# Get keys from https://cloud.langfuse.com or your self-hosted instance.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com